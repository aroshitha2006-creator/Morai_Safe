rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && 
         request.auth.token.email.lower() == 'aroshitha2006@gmail.com' && 
         request.auth.token.email_verified == true)
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 2. Users Collection (PII Isolated)
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId &&
        incoming().keys().hasAll(['fullName', 'email', 'phone', 'preferredDistrict', 'role']) &&
        incoming().fullName is string && incoming().fullName.size() <= 100 &&
        incoming().email is string && incoming().email.size() <= 120 &&
        incoming().phone is string && incoming().phone.size() <= 20 &&
        incoming().role == 'user'; // Prevent privilege self-assignment
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin()) &&
        incoming().role == existing().role; // Role is immutable
      allow delete: if isAdmin();
    }

    // 3. Alerts Collection
    match /alerts/{alertId} {
      allow read: if true; // Public access for life-safety warnings
      allow create, update, delete: if isAdmin();
    }

    // 4. Safe Zones & Shelters Collection
    match /safeZones/{facilityId} {
      allow read: if true; // Public access for community evacuation
      allow create, update, delete: if isAdmin();
    }

    // 5. Alert Acknowledgements
    match /alertAcknowledgements/{ackId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isSignedIn() &&
        incoming().userId == request.auth.uid &&
        incoming().keys().hasAll(['alertId', 'userId', 'userName', 'timestamp']) &&
        incoming().userName is string && incoming().userName.size() <= 100;
      allow update, delete: if isAdmin();
    }

    // 6. Community Incident Reports
    match /incidentReports/{incidentId} {
      allow get: if true;
      allow list: if isAdmin() || (isSignedIn() && resource.data.status == 'approved');
      allow create: if isSignedIn() &&
        incoming().keys().hasAll(['userName', 'userPhone', 'incidentType', 'title', 'description', 'district']) &&
        incoming().status == 'pending'; // Citizens cannot self-approve reports
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 7. Broadcast Campaigns
    match /broadcasts/{broadcastId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // 8. Audit Logs (Immutable)
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() &&
        incoming().keys().hasAll(['adminEmail', 'adminName', 'action', 'category', 'details', 'timestamp']);
      allow update, delete: if false; // Audit logs are strictly immutable
    }
  }
}
